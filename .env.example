# ============================================================
# Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- LLM Provider ---
# Provider: "auto" | "openrouter" | "openai" | "anthropic"
LLM_PROVIDER=auto

# Model identifier (provider-specific)
LLM_MODEL=openai/gpt-4o-mini

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.0

# API key for OpenAI and Anthropic providers
# LLM_API_KEY=sk-...

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Secure MCP Server (007-secure-mcp-server) ---
# MCP_API_KEYS_JSON={"admin":"key1","agent":"key2"}
# MCP_CACHE_TTL_SECONDS=60
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_RATE_LIMIT_BURST=20
# MCP_TOOL_TIMEOUT_SECONDS=10
# MCP_ERROR_RATE_THRESHOLD=0.1
# MCP_MOCK_FAILURE_MODE=off
# MCP_MOCK_LATENCY_MS=0
# MCP_TLS_ENABLED=false
# MCP_TLS_CERT_PATH=
# MCP_TLS_KEY_PATH=
# MCP_SEED_CUSTOMERS=12
# MCP_SEED_ORDERS=20
# MCP_SEED_PRODUCTS=10
# MCP_SEED_TICKETS=15
